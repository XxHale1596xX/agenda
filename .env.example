# Copie para .env e preencha os valores reais. NUNCA commite o .env.

# ── Banco de dados ────────────────────────────────────────────────────────────
# Senha do root do MySQL (use algo forte, não "root")
MYSQL_ROOT_PASSWORD=troque-por-senha-forte

# Usuário e senha da aplicação (refletidos em DATABASE_URL)
MYSQL_USER=agenda
MYSQL_PASSWORD=troque-por-senha-forte
MYSQL_DATABASE=agenda

DATABASE_URL=mysql+pymysql://agenda:troque-por-senha-forte@mysql:3306/agenda

# ── Admin ─────────────────────────────────────────────────────────────────────
# Produção: gere o hash e use ADMIN_TOKEN_HASH (ADMIN_TOKEN_HASH tem precedência)
# Para gerar: python3 -c "from passlib.context import CryptContext; print(CryptContext(['bcrypt']).hash('sua-senha'))"
ADMIN_TOKEN_HASH=

# Dev: use ADMIN_TOKEN com texto puro (deixe vazio em produção se usar ADMIN_TOKEN_HASH)
ADMIN_TOKEN=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=troque-por-chave-aleatoria-forte

# ── CORS ──────────────────────────────────────────────────────────────────────
# Produção: use o domínio real
ALLOWED_ORIGINS=https://app.scaleopsolutions.com

# ── Docs (Swagger / ReDoc) ────────────────────────────────────────────────────
# true  = habilita /docs e /redoc (dev)
# false = desabilita em produção
DOCS_ENABLED=false

# ── Log ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
